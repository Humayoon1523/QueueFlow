# QueueFlow Cloud Environment Configuration
NEXT_PUBLIC_BASE_URL=https://queueflow-ai.vercel.app

# Payment Gateway Credentials (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Kitchen Audio Broadcast
NEXT_PUBLIC_ENABLE_AUDIO_BROADCAST=true

# Port Configuration
PORT=3000
NODE_ENV=production
